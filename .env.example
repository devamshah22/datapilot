# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# Google Gemini API (free tier) — get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here

# Groq API (free tier, optional, for cheap validation calls) — get from https://console.groq.com
GROQ_API_KEY=

# Default model selection
PRIMARY_MODEL=gemini-2.5-flash
VALIDATOR_MODEL=gemini-2.5-flash

# App settings
LOG_LEVEL=INFO
MAX_AGENT_RETRIES=3
