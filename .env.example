# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# --- LLM provider ---
# Which provider to use for all LLM calls.
#   "groq"   — recommended; generous free tier (typically 14,400 RPD)
#   "gemini" — Google AI Studio; tighter free tier (often <50 RPD)
LLM_PROVIDER=groq

# --- Groq (recommended) ---
# Get a key at https://console.groq.com (free tier, no credit card)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (alternative) ---
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
PRIMARY_MODEL=gemini-2.0-flash
VALIDATOR_MODEL=gemini-2.0-flash

# --- App settings ---
LOG_LEVEL=INFO
MAX_AGENT_RETRIES=3

# --- Session memory ---
# "memory" — process-local, lost on restart (good for tests / offline dev)
# "supabase" — Postgres via Supabase, persistent across restarts and days
SESSION_BACKEND=supabase
# Sessions never auto-expire (0 = no TTL). Users delete via the UI.
SESSION_TTL_SECONDS=0
# Get these at https://supabase.com → Project Settings → API
# Use the legacy service_role key (starts with eyJ...), NOT the new sb_secret_ format
# (the Python client doesn't support the new format yet as of 2026).
SUPABASE_URL=
SUPABASE_KEY=

# --- Safety / rate limits ---
# Hard timeout per SQL query (seconds). Pathological queries are killed.
SQL_TIMEOUT_SECONDS=10
# Per-IP rate limits. Format: <count>/<minute|second|hour|day>
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_DEFAULT=60/minute
# CORS allow-list. Comma-separated origins, or '*' for any (dev only).
CORS_ALLOWED_ORIGINS=*
